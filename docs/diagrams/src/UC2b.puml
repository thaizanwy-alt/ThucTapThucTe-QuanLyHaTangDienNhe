@startuml UC2b
!include style.iuml
left to right direction
skinparam ranksep 24
title UC2b — MANAGER: thi công, kiểm tra và bàn giao

actor "Quản lý\nMANAGER" as manager
rectangle "Hệ thống quản lý thi công hạ tầng điện nhẹ" {
  usecase "Tạo Task; sửa / giao lại\nkhi ASSIGNED hoặc RETURNED" as assign
  usecase "Duyệt / trả Task\nkhi SUBMITTED" as review
  usecase "Xem mẫu; tạo / xem phiếu\nGhi kết quả Item theo quy tắc" as inspect
  usecase "Ghi FAIL và tạo Issue\nGiao lại Issue khi OPEN" as issue
  usecase "Recheck Issue RESOLVED\nPASS: đóng lỗi; FAIL: mở lại" as recheck
  usecase "Xem / tải / upload minh chứng\nSửa chú thích / xóa mềm khi được phép" as evidence
  usecase "Tạo / sửa DRAFT; readiness\nConfirm / tạo replacement" as acceptance
  usecase "Đọc snapshot CONFIRMED\nXem / tải file ghim" as snapshot
  usecase "Xuất PDF / ZIP hồ sơ CONFIRMED\nXuất hai Excel toàn Project" as export
}
manager -- assign
manager -- review
manager -- inspect
manager -- issue
manager -- recheck
manager -- evidence
manager -- acceptance
manager -- snapshot
manager -- export

legend bottom
  CONFIRMED bất biến; replacement có điều kiện.
  PDF: snapshot. Excel: hiện tại. ZIP: kết hợp.
  Không tự hoàn thành Project hoặc ghi đã ký.
endlegend
@enduml
