' Shared local style; no remote includes.
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam defaultFontColor #182C3A
skinparam titleFontSize 23
skinparam titleFontColor #182C3A
skinparam ArrowColor #5D7180
skinparam ArrowThickness 1.2
skinparam roundcorner 12
skinparam nodesep 28
skinparam ranksep 38
skinparam padding 10
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam rectangleBackgroundColor #FFFFFF
skinparam rectangleBorderColor #6B8797
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #6B8797
skinparam componentBackgroundColor #EFF5F8
skinparam componentBorderColor #476579
skinparam nodeBackgroundColor #F6F9FB
skinparam nodeBorderColor #476579
skinparam databaseBackgroundColor #EFF5F8
skinparam databaseBorderColor #476579
skinparam usecaseBackgroundColor #EFF5F8
skinparam usecaseBorderColor #476579
skinparam actorBorderColor #284B63
skinparam actorBackgroundColor white
skinparam noteBackgroundColor #FAFBFC
skinparam noteBorderColor #AAB8C2
skinparam noteFontSize 15
skinparam legendFontName Arial
skinparam legendFontSize 18
skinparam legendBackgroundColor #FAFBFC
skinparam legendBorderColor #AAB8C2
skinparam footerFontSize 12
skinparam footerFontColor #5D7180
